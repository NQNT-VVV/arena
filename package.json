{
  "name": "arena",
  "version": "0.1.0",
  "private": true,
  "description": "Arena \u2014 battles creatives : l'animateur impose des contraintes, les participants creent contre la montre, tout le monde note en aveugle.",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node.js",
    "predev": "node scripts/check-node.js",
    "dev": "node --watch server/index.js",
    "prestart": "node scripts/check-node.js",
    "start": "NODE_ENV=production node server/index.js",
    "prebuild": "node scripts/check-node.js",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-node.js",
    "test": "node test/e2e.mjs",
    "pretest:state": "node scripts/check-node.js",
    "test:state": "node test/state.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.19.2",
    "next": "^15.5.24",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
