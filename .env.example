# Arena — configuration. Copier en .env et adapter.
# Aucune valeur n'est ecrite en dur dans le code : tout se regle ici.

# --- Obligatoire en production ---------------------------------------------
# Signature des jetons participant et animateur. Sans valeur fixe, chaque
# redemarrage invalide les identites et tout le monde perd sa place.
#   openssl rand -hex 32
SESSION_SECRET=

# --- Reseau -----------------------------------------------------------------
PORT=3000
METRICS_PORT=9464
# Origine publique, pour les liens d'invitation et les QR codes.
# Vide = deduite de la requete.
PUBLIC_URL=

# --- Donnees ----------------------------------------------------------------
DATA_DIR=./data
# DB_PATH=./data/arena.db
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./data/media

# Driver S3 : pas encore branche, les variables sont deja lues.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PREFIX=arena/

# --- Retention --------------------------------------------------------------
# Sessions terminees conservees (heures), puis purgees avec leurs fichiers.
RETENTION_HOURS=336
# Sessions jamais lancees, abandonnees en preparation ou en lobby.
STALE_HOURS=12

# --- Limites ----------------------------------------------------------------
MAX_SESSIONS=200
MAX_PARTICIPANTS=200
MAX_ASSETS=30
MAX_FILE_BYTES=209715200
MAX_ASSETS_BYTES=524288000

# --- Reglages par defaut d'une session --------------------------------------
# L'animateur peut tous les ecraser a la creation.
DEFAULT_MEDIA_TYPE=audio
DEFAULT_DURATION_S=3600
DEFAULT_GRACE_S=120
DEFAULT_ALERTS_S=600,120,60,30
DEFAULT_END_SOUND=true
DEFAULT_PLAY_MAX_S=45
DEFAULT_FADE_OUT_S=3
DEFAULT_SCALE=5
DEFAULT_VOTE=3
DEFAULT_LATE_POLICY=reject
DEFAULT_LATE_PENALTY=1
DEFAULT_HOST_VOTES=false
DEFAULT_AUTO_ADVANCE=false
# Diffusion : passer seul au rendu suivant, apres l'ecoute et la fenetre de vote.
DEFAULT_AUTO_NEXT=true
DEFAULT_VOTE_WINDOW_S=15
# Les telephones des participants jouent-ils le son ? Faux si une enceinte suffit.
DEFAULT_PLAYER_AUDIO=true

# --- Transcodage ------------------------------------------------------------
TRANSCODE_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Discord (module optionnel, pas encore developpe) -----------------------
DISCORD_WEBHOOK_URL=
